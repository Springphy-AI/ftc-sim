# Copy this file to sim.properties (same folder) to set defaults for run-sim.bat / run-sim.sh.
# Command-line options override these.

# The game: a season pack in seasons/ (biobuzz, decode, ...). Default biobuzz.
#season=decode

# Your FtcRobotController project (the folder that contains TeamCode/). A path is read as
# written: on Windows, C:\Users\you\... and C:/Users/you/... both work.
#project=C:/Users/you/Documents/GitHub/FtcRobotController

# Robot description to simulate (see robots/).
robot=robots/mecanum.json

# More robots on the same field (up to 4, two per alliance). A robot without its own
# projectN / robotN uses robot 1's. Default alliances: robot 1 red, 2 blue, 3 red, 4 blue.
#robots=2
#project2=C:/Users/you/Documents/GitHub/OtherTeam/FtcRobotController
#robot2=robots/tank.json
#alliance2=blue

# Web port for the browser Driver Station.
port=8080

# Open the browser automatically when the simulator starts.
open_browser=true
